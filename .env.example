# Copy this file to .env for local `netlify dev` use, and set the same
# values in the Netlify dashboard (Site settings -> Environment variables)
# for the deployed site. Never commit the real .env file.

# --- Supabase ---
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# The "anon" public key. Safe to expose to the browser if ever needed, but
# today only the checkout/live-price Functions call Supabase, so this is
# mainly kept for the admin-app's client-side Supabase Auth login.
SUPABASE_ANON_KEY=
# The "service_role" secret key. Server-side only (Netlify Functions), never
# sent to the browser. Bypasses Row Level Security, so guard it carefully.
SUPABASE_SERVICE_ROLE_KEY=

# Same project as above, but Vite only inlines env vars prefixed VITE_ into
# the browser bundle — these two power the storefront's optional "Sign in
# with Google" flow (src/lib/supabase.ts). Same URL/anon key values as
# SUPABASE_URL / SUPABASE_ANON_KEY, just duplicated under the VITE_ prefix.
# If left unset, Google sign-in silently disables itself and guest checkout
# keeps working — see src/lib/supabase.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Google OAuth (only needed once, to configure Supabase Auth's Google
# provider in the dashboard — not read directly by any app code) ---
# Google Cloud Console -> APIs & Services -> Credentials -> your OAuth
# client's "Web application" entry.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Stripe ---
# Dashboard -> Developers -> API keys. Use the sk_test_... key while
# building; switch to the sk_live_... key only once the alcohol-merchant
# review is approved and this is deploying to production.
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks -> (your endpoint) -> Signing secret.
# Needed to verify that webhook requests really came from Stripe.
STRIPE_WEBHOOK_SECRET=

# Dashboard -> Developers -> API keys -> the pk_test_.../pk_live_... key
# (safe to expose to the browser — it's the publishable half of the pair
# above). Vite-prefixed so it's inlined into the browser bundle. Only
# needed when CHECKOUT_UI_MODE=elements below; hosted mode never loads
# Stripe.js client-side at all.
VITE_STRIPE_PUBLISHABLE_KEY=

# Feature flag for the checkout UI (create-checkout-session.ts). "hosted"
# (or unset) keeps the already-verified Stripe-hosted Checkout page redirect
# flow. "elements" switches to an in-page Payment Element mounted inside the
# cart drawer instead — see PROJECT_STATUS.md for the rollout plan. Safe to
# flip back to "hosted" at any time; both branches share the same order
# creation, webhook, and refund code.
CHECKOUT_UI_MODE=hosted

# Secret key for hashing (HMAC-SHA256) the requester's IP before it's used
# for checkout rate limiting (see create-checkout-session.ts and
# 0008_checkout_hardening.sql) — the raw IP itself is never stored anywhere.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional: if unset, IP-based rate limiting is silently skipped (per-email
# rate limiting still applies) rather than checkout failing outright.
RATE_LIMIT_HMAC_SECRET=

# --- Resend (order confirmation + staff notification emails) ---
# Dashboard -> API Keys. Requires verifying a sending domain first
# (e.g. trinityglobe.sg) before emails will actually deliver.
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@trinityglobe.sg
# Comma-separated list of staff emails that get a "new order" notification.
STAFF_NOTIFICATION_EMAILS=

# --- Store settings fallback (only used if store_settings table is empty) ---
FREE_SHIPPING_THRESHOLD_CENTS=12000
STANDARD_SHIPPING_FEE_CENTS=1500

# --- Site URL (used to build Stripe success/cancel redirect links) ---
# Local dev with `netlify dev`: http://localhost:8888
# Production: the live site's canonical URL, e.g. https://trinityglobe.sg
SITE_URL=http://localhost:8888

# --- Admin app origin (for the admin-refund-order Function's CORS headers) ---
# The URL admin-app/ ends up deployed at, e.g. https://admin.trinityglobe.sg
ADMIN_APP_ORIGIN=
