# Copy to .env for local `npm run dev`, and set in the Netlify dashboard for
# whatever site this admin app is deployed to (see the comment in
# vite.config.ts — it's a separate deploy from the storefront).
#
# Only the anon key goes here — this is a browser app. Row Level Security
# (see supabase/migrations/0001_init.sql) is what actually restricts staff
# to their role's permissions; the service_role key must NEVER appear here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Base URL of the storefront site that hosts netlify/functions/ (this admin
# app has no Functions of its own) — used to call admin-refund-order.
# Local dev against `netlify dev` on the storefront: http://localhost:8888
VITE_STOREFRONT_FUNCTIONS_URL=http://localhost:8888

